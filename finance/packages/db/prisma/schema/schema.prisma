generator client {
  provider = "prisma-client"
  output   = "../generated"
  moduleFormat = "esm"
  runtime = "bun"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExtratoType {
  Empresa
  Pessoal
}

model DasPayment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  month     String   @db.VarChar(7) // formato "YYYY-MM"
  paid      Boolean  @default(false)
  paidAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("das_payments")
}

model ExtratoRecord {
  id                    String                 @id @default(uuid())
  userId                String?                @map("user_id")
  data                  DateTime
  valor                 Decimal                @db.Decimal(15, 2)
  identificador         String                 @unique @db.VarChar(255)
  descricao             String?
  tipoOperacao          String?                @map("tipo_operacao") @db.VarChar(100)
  remetenteDestinatario String?                @map("remetente_destinatario") @db.VarChar(255)
  documento             String?                @db.VarChar(50)
  instituicaoFinanceira String?                @map("instituicao_financeira") @db.VarChar(255)
  codigoBanco           String?                @map("codigo_banco") @db.VarChar(10)
  agencia               String?                @db.VarChar(20)
  conta                 String?                @db.VarChar(50)
  tipo                  ExtratoType?
  createdAt             DateTime               @default(now()) @map("created_at")
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, data], map: "idx_user_id_data")
  @@index([descricao(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_descricao_trgm")
  @@map("extrato_records")
}
