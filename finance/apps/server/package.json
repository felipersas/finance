    "@finance/db": "*",
    "@trpc/server": "^11.5.0",
    "ai": "^5.0.49",
    "better-auth": "^1.3.29",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.2",
    "elysia": "^1.3.21",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
