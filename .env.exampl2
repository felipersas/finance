# Main environment file for Docker Compose
# Copy this to .env and fill in your actual values

# OpenAI API Key (required for MCP chatbot and server)
OPENAI_API_KEY=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


# MySQL Database Configuration
